{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "admin/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/admin/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/health", "destination": "/api/index.ts" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/assets/(.*)", "destination": "/assets/$1" }
  ]
}
